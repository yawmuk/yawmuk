# «يومك» Yawmuk: environment variables. Copy to .env (never commit .env) and run:
#   npm run build && node --env-file=.env server.mjs
# Every variable is optional: with none set, the game runs fully and the AI features use their
# deterministic fallbacks (default journey, verbatim reviewed passages, text-only guide).

# --- AI: Gemini on Vertex AI (the default provider; no API key) -------------------------------------
# On Cloud Run the service account is used automatically (needs roles/aiplatform.user).
# Locally: GOOGLE_ACCESS_TOKEN=$(gcloud auth print-access-token)   (expires after about an hour)
GOOGLE_CLOUD_PROJECT=
GOOGLE_ACCESS_TOKEN=
# LLM_PROVIDER=vertex        # force a provider: vertex | claude (unset = automatic)
# VERTEX_LOCATION=global
# YAWMUK_GEMINI_MODEL=gemini-3-flash-preview
# YAWMUK_GEMINI_FALLBACK=gemini-2.5-flash

# --- AI: alternatives (set ONE only if you do not use Vertex) ---------------------------------------
# Google AI Studio key. WARNING: when set it takes priority over Vertex; a key with no credit breaks AI.
# GEMINI_API_KEY=
# Anthropic Claude. When set (and LLM_PROVIDER is not "vertex") Claude is used instead of Gemini.
# ANTHROPIC_API_KEY=
# YAWMUK_MODEL=claude-sonnet-5-5

# --- Voice (text-to-speech): uses the same Google credentials as above -----------------------------
# YAWMUK_TTS_MODEL=gemini-3.8-flash-tts
# YAWMUK_TTS_FALLBACKS=gemini-3.8-flash-lite-tts
# YAWMUK_TTS_VOICE=Charon

# --- Scholar dashboard /experts (both required, otherwise the dashboard stays locked) --------------
EXPERTS_PASSCODE=
SESSION_SECRET=
# Optional: unlocks free-text comments in the study CSV export
# STUDY_ADMIN_KEY=

# --- Storage ------------------------------------------------------------------------------------------
# Local default: JSON files in ./data. On Cloud Run use Firestore (files there are lost on restart).
# DATA_DIR=./data
# STORE=firestore
# FIRESTORE_DATABASE=(default)
# PORT=8080
